msgstr "Білі"

#. The side to move in today's puzzle, under the label "To play".
#: modes/puzzles_page.cpp
msgctxt "to play"
msgid "White"
msgstr "Білі"

#. Pass & Play, state line: White's king is in check.
#: modes/game_scene.cpp
msgid "White is in check"
msgstr "Шах білим"

#. In the empty list of moves of a Pass & Play game.
#: modes/game_scene.cpp
msgid "White moves first"
msgstr "Білі ходять першими"

#. Result card, how the game ended.
#: modes/game_scene.cpp
msgid "White resigned"
msgstr "Білі здалися"

#. It is White's move. On the puzzle screen a short line at the top of a Puzzle Streak or Puzzle Storm run: at most 20 letters.
#: modes/game_scene.cpp, modes/puzzle_scene.cpp
msgid "White to move"
msgstr "Хід білих"

#. The large heading of a puzzle: it is White's move. About 19 letters (24 are shrunk to fit).
#: modes/home_page.cpp, modes/puzzle_scene.cpp
msgid "White to play"
msgstr "Хід білих"

#. Pass & Play, the large title of the result card and the state line.
#: modes/game_scene.cpp
msgid "White wins"
msgstr "Білі перемогли"

#. Under the material bar: {0} is what White's pieces are worth, in pawns ("White 38").
#: modes/tv_scene.cpp, modes/watch_page.cpp
msgid "White {0}"
msgstr "Білі {0}"

#. Lichess TV, under a player's name: this player has the white pieces and it is their turn.
#: modes/tv_scene.cpp
msgid "White · to move"
msgstr "Білі · ходять"

#. Under the step Scan. About 30 letters.
#: modes/account_scene.cpp
msgid "With your phone"
msgstr "Камерою телефона"

#. Beside or under a player's name once the game is over: this player won. One short word (about 10 letters).
#: modes/game_scene.cpp
msgid "Won"
msgstr "Перемога"

#. Under a percentage in the middle of a ring: the share of games the player won. In capitals on screen: about 6 letters.
#: modes/profile_page.cpp
msgctxt "share of games"
msgid "Won"
msgstr "Перемог"

#: modes/settings_page.cpp
msgid "Wood, marble or flat colours."
msgstr "Дерево, мармур або однотонні кольори."

#. Puzzle theme, named as on lichess.org (lichess.org/training/themes): use the name Lichess shows in your language. It stands on a card (about 17 letters fit one line, a longer name takes two smaller lines) and on a small tag.
#: puzzles/pack.cpp
msgctxt "puzzle theme"
msgid "X-ray attack"
msgstr "Рентген"

#. A small label beside the player's rating on a scale. At most 8 letters.
#: modes/puzzles_page.cpp
msgid "You"
msgstr "Ви"

#. Game screen, state line: the player's king is in check.
#: modes/game_scene.cpp
msgid "You are in check"
msgstr "Вам шах"

#. Large title of at most two lines, each of about 20 letters.
#: modes/play_page.cpp
msgid "You are offline"
msgstr "Ви офлайн"

#. On the web page the phone shows when signing in worked.
#: modes/account_scene.cpp
msgid "You can put your phone away and return to your PS5."
msgstr "Можна відкласти телефон і повернутися до PS5."

#: puzzles/pack_source.cpp
msgid "You have solved every puzzle here"
msgstr "Ви вирішили тут усі задачі"

#. Beside the choice White. About 24 letters.
#: modes/play_page.cpp
msgid "You move first"
msgstr "Ви ходите першими"

#. After the speed and a dot, in lower case: "Rapid · you play Black".
#: modes/play_page.cpp
msgid "you play Black"
msgstr "ви граєте чорними"

#. After the speed and a dot, in lower case: "Rapid · you play White".
#: modes/play_page.cpp
msgid "you play White"
msgstr "ви граєте білими"

#: modes/update_scene.cpp
msgid "Your account, games and settings are kept."
msgstr "Обліковий запис, ігри та налаштування збережуться."

#. Heading over the player's rating at this speed. In capitals on screen. About 28 letters.
#: modes/play_page.cpp
msgid "Your blitz rating"
msgstr "Ваш рейтинг у бліці"

#. Heading over the player's rating at this speed. In capitals on screen. About 28 letters.
#: modes/play_page.cpp
msgid "Your bullet rating"
msgstr "Ваш рейтинг у кулі"

#. Heading over the player's rating at this speed. In capitals on screen. About 28 letters.
#: modes/play_page.cpp
msgid "Your classical rating"
msgstr "Ваш рейтинг у класичних шахах"

#. Under the game menu's title: the menu does not pause an online game.
#: modes/game_scene.cpp
msgid "Your clock keeps running while you are here"
msgstr "Ваш годинник іде, поки ви тут"

#. Heading over the choice of side against the computer. About 24 letters.
#: modes/play_page.cpp
msgid "Your colour"
msgstr "Ваш колір"

#. Heading over the player's rating at this speed. In capitals on screen. About 28 letters.
#: modes/play_page.cpp
msgid "Your correspondence rating"
msgstr "Ваш рейтинг у заочних шахах"

#. Under "No rating yet": "it" is the rating. One line of about 45 letters.
#: modes/play_page.cpp
msgid "Your first games at this speed set it."
msgstr "Його визначать перші ігри з цим контролем."

#. Small heading on the card of one of the player's online games. About 10 letters.
#: modes/home_page.cpp
msgid "Your game"
msgstr "Ваша гра"

#. Under the Pass & Play card. About 34 letters.
#: modes/home_page.cpp
msgid "Your game is saved"
msgstr "Вашу гру збережено"

#. The state of the puzzle: the player is to move.
#: modes/game_scene.cpp, modes/home_page.cpp, modes/profile_page.cpp, modes/puzzle_scene.cpp, modes/shell_scene.cpp
msgid "Your move"
msgstr "Ваш хід"

#. Title of the card that asks the player to answer: the opponent wants to take their last move back.
#: modes/game_scene.cpp
msgid "Your opponent asks for a takeback"
msgstr "Суперник просить повернути хід"

#. Short message. "Claim victory" is a row of the game menu: use the same words.
#: modes/game_scene.cpp
msgid "Your opponent left. Claim victory from the menu."
msgstr "Суперник вийшов. Виберіть у меню «Оголосити перемогу»."

#. Title of the card that asks the player to answer.
#: modes/game_scene.cpp
msgid "Your opponent offers a draw"
msgstr "Суперник пропонує нічию"

#. While waiting; no full stop at the end.
#: modes/account_scene.cpp
msgid "Your phone approved it. Fetching your account"
msgstr "Телефон підтвердив вхід. Отримуємо обліковий запис"

#. "Signed in" is the start of what the phone shows ("Signed in to ProsperoLichess"): word the two alike.
#: modes/account_scene.cpp
msgid "Your phone shows \"Signed in\" and ProsperoLichess continues by itself."
msgstr "На телефоні з'явиться «Ви увійшли», а ProsperoLichess продовжить сам."

#. A small label in capitals over the player's puzzle rating. About 21 letters (27 are shrunk to fit).
#: modes/puzzles_page.cpp
msgid "Your puzzle rating"
msgstr "Ваш рейтинг у задачах"

#. Heading over the player's rating at this speed. In capitals on screen. About 28 letters.
#: modes/play_page.cpp
msgid "Your rapid rating"
msgstr "Ваш рейтинг у швидких шахах"

#. A small label over the player's puzzle rating. About 15 letters.
#: modes/puzzle_scene.cpp, modes/puzzles_page.cpp
msgid "Your rating"
msgstr "Ваш рейтинг"

#. Under an empty figure, for a signed-in player without a puzzle rating. About 30 letters (two short lines at most).
#: modes/puzzles_page.cpp
msgid "Your rating is not known yet"
msgstr "Ваш рейтинг ще невідомий"

#. A small caption over a line chart of the player's puzzle rating.
#: modes/puzzles_page.cpp
msgid "Your rating over time"
msgstr "Ваш рейтинг із часом"

#. "Profile" is a page's name: word it as in its own entry.
#: modes/account_scene.cpp
msgid "Your ratings and your games in progress are on the Profile page, and signing out is there too."
msgstr "Ваші рейтинги та поточні ігри — на сторінці «Профіль», вихід з облікового запису теж там."

#. Under a game's card: the player has the move.
#: modes/home_page.cpp
msgid "Your turn"
msgstr "Ваш хід"

#. Under a game's card: {0} is the game's speed (Rapid, Correspondence...). About 34 letters with it.
#: modes/home_page.cpp
msgid "Your turn · {0}"
msgstr "Ваш хід · {0}"

#. Puzzle theme, named as on lichess.org (lichess.org/training/themes): use the name Lichess shows in your language. It stands on a card (about 17 letters fit one line, a longer name takes two smaller lines) and on a small tag.
#: puzzles/pack.cpp
msgctxt "puzzle theme"
msgid "Zugzwang"
msgstr "Цугцванг"

#. Credits: {0}, {1} and {2} are piece sets' names. Keep the licences' names in brackets.
#: modes/settings_page.cpp
msgid "{0} and {1} (GPLv2+), {2} (Apache-2.0)"
msgstr "{0} і {1} (GPLv2+), {2} (Apache-2.0)"

#. {0} is a player's name: that player invites you to a game.
#: lichess/session.cpp
msgid "{0} challenges you"
msgstr "{0} кидає вам виклик"

#. Under the token field, after a dot; {0} is 1.
#: modes/account_scene.cpp
msgid "{0} character typed"
msgstr "введено {0} символ"

#. Under the token field, after a dot; {0} is a number.
#: modes/account_scene.cpp
msgid "{0} characters typed"
msgstr "введено символів: {0}"

#. A correspondence time control, as a large figure on a tile: "1 day". Very short.
#: lichess/board_link.cpp, modes/play_setup.cpp, modes/start_game_scene.cpp
msgid "{0} day"
msgstr "{0} день"

#. The chosen correspondence time control in words; {0} is 1.
#: modes/play_setup.cpp
msgid "{0} day for every move"
msgstr "{0} день на кожен хід"

#. A correspondence time control, as a large figure on a tile: "3 days". {0} is 2 or more. Very short.
#: lichess/board_link.cpp, modes/play_setup.cpp, modes/start_game_scene.cpp
msgid "{0} days"
msgstr "{0} дн."

#. The chosen correspondence time control in words; {0} is 2 or more.
#: modes/play_setup.cpp
msgid "{0} days for every move"
msgstr "Днів на кожен хід: {0}"

#. The profile's legend when the count is exactly 1.
#: modes/profile_page.cpp
msgctxt "of one game"
msgid "{0} drawn"
msgstr "{0} внічию"

#. Legend of the results: {0} is a number of games ("243 drawn"). Lower case, the word about 7 letters. For an account without games the line stands without {0}.
#: modes/profile_page.cpp
msgid "{0} drawn"
msgstr "{0} внічию"

#. Credits: {0} is "OpenGL 4.6", {1} is the project "Mesa".
#: modes/settings_page.cpp
msgid "{0} for PS5, built on {1}"
msgstr "{0} для PS5 на основі {1}"

#. How many games a rating rests on; {0} is 1.
#: modes/play_page.cpp, modes/profile_page.cpp
msgid "{0} game"
msgstr "{0} гра"

#. Title of the menu's card: {0} is 1, the number of games in which it is the player's turn. About 16 letters.
#: modes/shell_scene.cpp
msgid "{0} game waits"
msgstr "{0} гра чекає"

#. How many games a rating rests on; {0} is a number such as 412 or 1,204. About 14 characters.
#: modes/play_page.cpp, modes/profile_page.cpp
msgid "{0} games"
msgstr "Ігор: {0}"

#. Title of the menu's card: {0} is the number of games (2 or more) in which it is the player's turn. About 16 letters.
#: modes/shell_scene.cpp
msgid "{0} games wait"
msgstr "Ігор чекає: {0}"

#. Time left to move: {0} is a clock such as 5:07 (minutes and seconds).
#: modes/home_page.cpp
msgctxt "time"
msgid "{0} left"
msgstr "Ще {0}"

#. What a game's clock still holds: {0} is minutes and seconds, such as 12:05. About 11 characters.
#: modes/profile_page.cpp
msgid "{0} left"
msgstr "Ще {0}"

#. The profile's legend when the count is exactly 1.
#: modes/profile_page.cpp
msgctxt "of one game"
msgid "{0} lost"
msgstr "{0} програно"

#. Legend of the results: {0} is a number of games ("1,122 lost"). Lower case, the word about 7 letters. For an account without games the line stands without {0}.
#: modes/profile_page.cpp
msgid "{0} lost"
msgstr "{0} програно"

#. The chosen time control in words: each player has {0} minutes (5 or more).
#: modes/play_setup.cpp
msgid "{0} minutes each"
msgstr "По {0} хв кожному"

#. The chosen time control in words: each player has {0} minutes (5 or more), and {1} seconds are added after each move. About 40 characters.
#: modes/play_setup.cpp
msgid "{0} minutes each, +{1} s per move"
msgstr "По {0} хв кожному, +{1} с на хід"

#. The summary of a Puzzle Storm run with exactly one mistake: {0} is the number of mistakes, {1} the longest row of solved puzzles.
#: modes/puzzle_scene.cpp
msgid "{0} mistake · best combo {1}"
msgstr "{0} помилка · найкраще комбо {1}"

#. The summary of a Puzzle Storm run: {0} is the number of mistakes, {1} the longest row of solved puzzles.
#: modes/puzzle_scene.cpp
msgid "{0} mistakes · best combo {1}"
msgstr "Помилок: {0} · найкраще комбо {1}"

#. Lichess TV: how many moves were played while watching, when it is one.
#: modes/game_scene.cpp, modes/tv_scene.cpp
msgid "{0} move"
msgstr "{0} хід"

#. Lichess TV: how many moves were played while watching.
#: modes/game_scene.cpp, modes/tv_scene.cpp
msgid "{0} moves"
msgstr "Ходів: {0}"

#. The place of the focused theme in the catalogue: {0} is its number, {1} how many there are ("1 of 74").
#: modes/puzzles_page.cpp
msgid "{0} of {1}"
msgstr "{0} із {1}"

#. How many puzzles a theme has, for exactly one; {0} is the number.
#: modes/puzzles_page.cpp
msgid "{0} puzzle"
msgstr "{0} задача"

#. How many puzzles a theme has; {0} is the number ("12,164"). About 20 letters.
#: modes/puzzles_page.cpp
msgid "{0} puzzles"
msgstr "Задач: {0}"

#. Under the puzzle rating: {0} is the number of puzzles solved ("1,960 solved"). Word it so that it reads well with any number.
#: modes/profile_page.cpp
msgid "{0} solved"
msgstr "Вирішено: {0}"

#. The puzzles of a Puzzle Storm run so far: {0} solved, {1} not solved ("4 solved · 1 missed"). Shown in small capitals.
#: modes/puzzle_scene.cpp
msgid "{0} solved · {1} missed"
msgstr "Вирішено: {0} · не вирішено: {1}"

#. {0} and {1} are the names of the two players of a game.
#: modes/home_page.cpp
msgid "{0} vs {1}"
msgstr "{0} — {1}"

#. The profile's legend when the count is exactly 1. The same as the text without this context if the language needs no other form.
#: modes/profile_page.cpp
msgctxt "of one game"
msgid "{0} won"
msgstr "{0} виграно"

#. Legend of the results: {0} is a number of games ("1,301 won"). Lower case, the word about 7 letters. For an account without games the line stands without {0}.
#: modes/profile_page.cpp
msgid "{0} won"
msgstr "{0} виграно"

#. What a search is for: {0} is the speed (Rapid), {1} the time control (10+5). Change the order if the language asks for it.
#: lichess/board_link.cpp, modes/play_setup.cpp
msgctxt "speed, time control"
msgid "{0} {1}"
msgstr "{0} {1}"

#. Under a player's name once the game is over: the game was drawn. {0} is their side.
#: modes/game_scene.cpp
msgid "{0} · draw"
msgstr "{0} · нічия"

#. Under a player's name: their king is in check. {0} is their side ("White", "Black", or "Black · level 3" for the computer).
#: modes/game_scene.cpp
msgid "{0} · in check"
msgstr "{0} · під шахом"

#. Under the opponent's name: they left, and the game menu now has "Claim victory". {0} is their side. About 40 letters.
#: modes/game_scene.cpp
msgid "{0} · left, claim the win in the menu"
msgstr "{0} · вийшли, оголосіть перемогу в меню"

#. Under the opponent's name: they left the game. {0} is their side, {1} the seconds until the player may claim the win. About 40 letters.
#: modes/game_scene.cpp
msgid "{0} · left, claim the win in {1} s"
msgstr "{0} · вийшли, перемога через {1} с"

#. Under the computer's name (Stockfish). {0} is its side ("White", "Black"), {1} its strength, 1 to 8.
#: modes/game_scene.cpp
msgid "{0} · level {1}"
msgstr "{0} · рівень {1}"

#. The puzzle before the one on the board, which the player skipped: {0} is its theme, {1} its rating. Shown in small capitals.
#: modes/puzzle_scene.cpp
msgid "{0} · rated {1} · skipped"
msgstr "{0} · рейтинг {1} · пропущено"

#. The puzzle before the one on the board: {0} is its theme, {1} its rating, {2} the seconds it took ("Fork · rated 888 · solved in 1 s"). Shown in small capitals.
#: modes/puzzle_scene.cpp
msgid "{0} · rated {1} · solved in {2} s"
msgstr "{0} · рейтинг {1} · вирішено за {2} с"

#. The puzzle before the one on the board, which the player got wrong: {0} is its theme, {1} its rating. Shown in small capitals.
#: modes/puzzle_scene.cpp
msgid "{0} · rated {1} · wrong move"
msgstr "{0} · рейтинг {1} · хибний хід"

#. Under the player's own name while the connection to the game is being made again. {0} is their side.
#: modes/game_scene.cpp
msgid "{0} · reconnecting…"
msgstr "{0} · відновлення зв'язку…"

#. Under the opponent's name: it is their turn. {0} is their side ("White", "Black", or "Black · level 3" for the computer).
#: modes/game_scene.cpp
msgid "{0} · thinking"
msgstr "{0} · думають"

#. Under a player's name once the game is over: this player won. {0} is their side.
#: modes/game_scene.cpp
msgid "{0} · won"
msgstr "{0} · перемога"

#. Under the player's own name. {0} is their side ("White", "Black"). Keep the dot.
#: modes/game_scene.cpp
msgid "{0} · your move"
msgstr "{0} · ваш хід"

#. Under the screen's name: {0} is the puzzle theme, {1} the difficulty ("Fork · Normal").
#: modes/puzzle_scene.cpp
msgid "{0} · {1}"
msgstr "{0} · {1}"

#. A share of a hundred; {0} is the number. Put the sign and any space where the language has them (49%, 49 %, %49).
#: core/strings.cpp
msgid "{0}%"
msgstr "{0}%"

#. Time spent playing: {0} days and {1} hours, each unit as one letter. A large figure: about 8 characters.
#: modes/profile_page.cpp
msgid "{0}d {1}h"
msgstr "{0}д {1}г"

#. What a game's clock still holds: {0} days and {1} hours, each unit as one letter. About 11 characters.
#: modes/home_page.cpp, modes/profile_page.cpp
msgid "{0}d {1}h left"
msgstr "Ще {0}д {1}г"

#. Time spent playing: {0} hours and {1} minutes, each unit as one letter. A large figure: about 8 characters.
#: modes/profile_page.cpp
msgid "{0}h {1}m"
msgstr "{0}г {1}хв"

#. What a game's clock still holds: {0} hours and {1} minutes, each unit as one letter. About 11 characters.
#: modes/home_page.cpp, modes/profile_page.cpp
msgid "{0}h {1}m left"
msgstr "Ще {0}г {1}хв"

#. Time spent playing: {0} minutes, the unit as one letter.
#: modes/profile_page.cpp
msgid "{0}m"
msgstr "{0} хв"

#. Seconds taken off the clock; {0} is the number, s stands for seconds ("–10 s"). Keep it short.
#: modes/puzzle_scene.cpp, modes/puzzles_page.cpp
msgid "–{0} s"
msgstr "–{0} с"
